<%- include('partials/header') %>

<div style="max-width: 600px; margin: 2rem auto;">
  <div class="card">
    <div class="card-header">
      <h2 class="card-title"><%= quiz && quiz.id ? 'Chỉnh sửa đề thi' : 'Tạo đề thi mới' %></h2>
    </div>

    <% if (error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <form action="<%= quiz && quiz.id ? '/admin/quizzes/' + quiz.id + '/edit' : '/admin/quizzes/new' %>" method="POST">
      <div class="form-group">
        <label for="title" class="form-label">Tiêu đề đề thi</label>
        <input type="text" id="title" name="title" class="form-control" value="<%= quiz ? quiz.title : '' %>" placeholder="Ví dụ: Kiểm tra Kiến trúc Vi dịch vụ và Docker..." required autofocus>
      </div>

      <div class="form-group">
        <label for="duration_min" class="form-label">Thời lượng làm bài (phút)</label>
        <input type="number" id="duration_min" name="duration_min" class="form-control" value="<%= quiz ? quiz.duration_min : 15 %>" min="1" max="180" required>
        <small style="color: var(--text-muted); display: block; margin-top: 0.25rem;">Quy định số phút đếm ngược khi thí sinh bắt đầu làm bài.</small>
      </div>

      <div style="display: flex; gap: 1rem; margin-top: 1.5rem;">
        <button type="submit" class="btn btn-primary" style="flex: 1;">Lưu đề thi</button>
        <a href="/admin/quizzes" class="btn btn-outline">Hủy</a>
      </div>
    </form>
  </div>
</div>

<%- include('partials/footer') %>
